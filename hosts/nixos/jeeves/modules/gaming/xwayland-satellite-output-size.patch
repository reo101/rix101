 #[test]
+fn output_resize_logical_size_before_mode() {
+    let mut f = Fixture::new_preset(|testwl| {
+        testwl.enable_xdg_output_manager();
+    });
+    let output = f.create_output(0, 0);
+    let xdg_output = f.testwl.get_xdg_output(&output).unwrap();
+    let connection = Connection::new(&f.display);
+
+    for (width, height) in [(2340, 1080), (3120, 1440), (2560, 1600), (1920, 1080)] {
+        // Niri can send xdg_output's logical size before wl_output's current mode.
+        xdg_output.logical_size(width, height);
+        output.mode(wl_output::Mode::Current, width, height, 60000);
+        xdg_output.done();
+        output.done();
+        f.testwl.dispatch();
+
+        let deadline = Instant::now() + Duration::from_secs(2);
+        loop {
+            let geometry = connection.get_reply(&x::GetGeometry {
+                drawable: x::Drawable::Window(connection.root),
+            });
+            if (geometry.width() as i32, geometry.height() as i32) == (width, height) {
+                break;
+            }
+            assert!(Instant::now() < deadline,
+                "X11 root stayed at {}x{} after resize to {width}x{height}",
+                geometry.width(), geometry.height());
+            std::thread::sleep(Duration::from_millis(10));
+            f.testwl.dispatch();
+        }
+    }
+}
