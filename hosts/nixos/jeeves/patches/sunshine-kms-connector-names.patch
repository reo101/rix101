+      for (const auto &card_descriptor : kms::card_descriptors) {
+        for (const auto &[_, monitor_descriptor] : card_descriptor.crtc_to_monitor) {
+          const auto connector_name = std::string {drmModeGetConnectorTypeName(monitor_descriptor.type)} + "-" + std::to_string(monitor_descriptor.index);
+          if (display_name == connector_name) {
+            BOOST_LOG(info) << "Mapped '"sv << display_name << "' to kmsgrab monitor index " << monitor_descriptor.monitor_index;
+            return monitor_descriptor.monitor_index;
+          }
+        }
+      }
+
+      BOOST_LOG(warning) << "Couldn't map '"sv << display_name << "' to a KMS monitor index. Falling back to index 0.";
+      return 0;
+    }
