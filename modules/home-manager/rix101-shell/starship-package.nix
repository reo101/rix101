# Starship built from unreleased upstream (native jj support), wrapped so the
# jujutsu runtime is on PATH for every invocation, including shell init
# scripts generated by `starship init <shell>` (the generator resolves its own
# binary via `which("starship")` falling back to `current_exe`, so wrapping
# the entrypoint itself is required; a bare PATH suffix would leave generated
# scripts pointing at the unwrapped binary).
{ pkgs }:

pkgs.starship.overrideAttrs (
  finalAttrs: oldAttrs: {
    version = "1.26.0-unstable-2026-09-27";

    src = pkgs.fetchFromGitHub {
      owner = "starship";
      repo = "starship";
      rev = "131bf9552d7e927607e155ea3a9b8c8a170a0356";
      hash = "sha256-H85gbkcFiGIOAx11F2/U+V2WxkDKhIF1qcasvnxN8L8=";
    };

    cargoDeps = pkgs.rustPlatform.fetchCargoVendor {
      inherit (finalAttrs) pname version src;
      hash = "sha256-g06GmHmTC5X6R/YgIvKcwnN//fvLwh3hhnOAFhWnMwA=";
    };

    nativeBuildInputs = (oldAttrs.nativeBuildInputs or [ ]) ++ [ pkgs.makeWrapper ];

    meta = oldAttrs.meta // {
      changelog = "https://github.com/starship/starship/commit/131bf9552d7e927607e155ea3a9b8c8a170a0356";
    };

    postFixup = (oldAttrs.postFixup or "") + ''
      wrapProgram "$out/bin/starship" \
        --prefix PATH : "$out/bin:${pkgs.lib.makeBinPath [ pkgs.jujutsu ]}"
    '';
  }
)
